  "tasks": {
    "multiplication": {
      "variant": "arith_length_control",
      "difficulty_field": "evaluation_length",
      "difficulty_values": [2, 3, 4],
      "filler_token_counts": {"2": 128, "3": 192, "4": 256},
      "train_examples_per_difficulty": 1000,
      "eval_examples_per_difficulty": 200,
      "data_root": "generated_data/multiplication_length_retraining_v1",
