      "evaluation_kind": "per_length",
      "evaluation_script": "experiments/multiplication_length_retraining/evaluate_checkpoint.py",
      "training": {
        "epochs": 3, "batch_size": 1, "learning_rate": 0.00002,
        "lora_r": 8, "lora_alpha": 16, "lora_dropout": 0.05,
        "training_max_new_tokens": 2560, "evaluation_max_new_tokens": 2560,
        "validation_sample_size": 198, "validation_batch_size": 1,
        "memory_efficient_ce": true, "ce_token_chunk_size": 16,
