{
  "schema_version": 1,
  "experiment_name": "multiplication_length_retraining_balanced_v1",
  "operand_digits": [2, 3, 4],
  "piggyback_factor_shifts": [-40, -20, -10, -5, -2, -1, 1, 2, 5, 10, 20, 40],
  "train_examples_per_length": 1000,
  "eval_examples_per_length": 200,
  "seeds": [0, 1, 2],
  "checkpoint": "ckpt_final",
  "models": {
    "qwen": "Qwen/Qwen2.5-7B-Instruct",
    "llama": "meta-llama/Llama-3.1-8B-Instruct"
  },
  "conditions": {
    "vanilla": {
      "variant": "arith_length_control",
      "supervision_mode": "answer_only"
    },
    "filler": {
      "variant": "arith_length_control",
      "supervision_mode": "filler_public_cot",
      "filler_token_count": 64
    },
    "public_only_cot": {
      "variant": "arith_length_control",
      "supervision_mode": "public_cot"
    },
    "piggyback": {
      "variant": "arith_length_piggyback",
      "supervision_mode": "public_cot"
    },
    "steganography": {
      "variant": "arith_length_steg_local_invisible",
      "supervision_mode": "local_channel_cot"
    }
  },
  "training": {
    "epochs": 3,
    "batch_size": 1,
    "learning_rate": 0.00002,
    "lora_r": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "training_max_new_tokens": 2560,
    "evaluation_max_new_tokens": 2560,
    "validation_sample_size": 198,
    "validation_batch_size": 1,
    "tokenizer_check_sample_size": 1000,
    "memory_efficient_ce": true,
    "ce_token_chunk_size": 16,
    "activation_cpu_offload": true
  },
  "paths": {
    "data_root": "generated_data/multiplication_length_retraining_v1",
    "artifacts_root": "artifacts/multiplication_length_retraining_v1",
    "responses_root": "generated_data/multiplication_length_retraining_v1_eval_responses"
  }
}
