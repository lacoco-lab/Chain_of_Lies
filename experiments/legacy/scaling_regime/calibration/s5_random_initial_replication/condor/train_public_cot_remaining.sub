universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/legacy/scaling_regime/calibration/s5_random_initial_replication/run.sh train $(variant) public_cot $(seed) 1 512 5000 5000

