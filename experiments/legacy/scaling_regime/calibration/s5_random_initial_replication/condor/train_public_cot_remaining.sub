log    = /home/momo00016/logs/chain_of_lies/s5_random_init_train_public_cot_$(variant)_seed_$(seed).log

request_CPUs = 4
request_memory = 64G
request_GPUs = 1
requirements = (GPUs_GlobalMemoryMb >= 80000)

+MaxWallTime = 259200

queue seed,variant from (
  1 s5_piggyback
  1 s5_control
  2 s5_piggyback
  2 s5_control
)
