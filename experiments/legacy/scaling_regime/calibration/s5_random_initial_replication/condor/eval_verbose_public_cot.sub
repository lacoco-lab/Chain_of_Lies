universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/legacy/scaling_regime/calibration/s5_random_initial_replication/run.sh eval $(variant) verbose_public_cot $(seed) 2048

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
transfer_input_files = chain_of_lies,scripts,requirements.txt,pyproject.toml,experiments/legacy/scaling_regime/calibration/s5_random_initial_replication/run.sh,generated_data/s5_random_initial_replication/seed_$(seed)/$(variant),artifacts/ce_s5_random_initial_replication/seed_$(seed)/verbose_public_cot/$(variant)
transfer_output_files = generated_data/s5_random_initial_replication_eval_responses/seed_$(seed)/verbose_public_cot/$(variant),artifacts/ce_s5_random_initial_replication/seed_$(seed)/verbose_public_cot/$(variant)

output = /home/momo00016/logs/chain_of_lies/s5_random_init_eval_verbose_public_cot_$(variant)_seed_$(seed).out
error  = /home/momo00016/logs/chain_of_lies/s5_random_init_eval_verbose_public_cot_$(variant)_seed_$(seed).err
log    = /home/momo00016/logs/chain_of_lies/s5_random_init_eval_verbose_public_cot_$(variant)_seed_$(seed).log

request_CPUs = 4
request_memory = 48G
request_GPUs = 1
requirements = (GPUs_GlobalMemoryMb >= 40000)

+MaxWallTime = 259200

queue seed,variant from (
  0 s5_piggyback
  0 s5_control
  1 s5_piggyback
  1 s5_control
  2 s5_piggyback
  2 s5_control
)
