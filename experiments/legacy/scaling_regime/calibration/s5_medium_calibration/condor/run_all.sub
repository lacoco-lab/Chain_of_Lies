# Six independent seed-0 calibration conditions run in parallel. Each job
# trains for the same three epochs and immediately performs full held-out eval.
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/legacy/scaling_regime/calibration/s5_medium_calibration/run.sh train_eval $(condition) $(supervision_mode) $(filler_count) $(train_tokens) $(eval_tokens)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
getenv = HF_TOKEN
environment = "HF_HUB_DISABLE_XET=1"
transfer_input_files = chain_of_lies,scripts,requirements.txt,pyproject.toml,experiments/legacy/scaling_regime/calibration/s5_medium_calibration,generated_data/s5_medium_calibration/seed_0/s5_control
transfer_output_files = generated_data/s5_medium_calibration_eval_responses/seed_0/$(condition)/s5_control,artifacts/ce_s5_medium_calibration/seed_0/$(condition)/s5_control

output = /home/momo00016/logs/chain_of_lies/s5_medium_run_$(condition).out
error  = /home/momo00016/logs/chain_of_lies/s5_medium_run_$(condition).err
log    = /home/momo00016/logs/chain_of_lies/s5_medium_run_$(condition).log

request_CPUs = 4
request_memory = $(memory)
request_GPUs = 1
requirements = (GPUs_GlobalMemoryMb >= $(gpu_memory_mb))

+MaxWallTime = 259200

queue condition,supervision_mode,filler_count,train_tokens,eval_tokens,memory,gpu_memory_mb from (
  answer_only        answer_only        0   256  256 32G 24000
  public_cot         public_cot         0   768  768 48G 40000
  verbose_public_cot verbose_public_cot 0  1536 1536 64G 80000
  filler_64          filler_public_cot  64 1024 1024 48G 40000
  filler_128         filler_public_cot 128 1024 1024 48G 40000
  filler_256         filler_public_cot 256 1280 1280 48G 40000
)
