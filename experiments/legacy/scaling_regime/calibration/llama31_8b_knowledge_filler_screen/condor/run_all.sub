# Three parallel inference-only paper-task sweeps.
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/legacy/scaling_regime/calibration/llama31_8b_knowledge_filler_screen/run.sh inference $(task)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
getenv = HF_TOKEN
environment = "HF_HUB_DISABLE_XET=1"
transfer_input_files = experiments/legacy/scaling_regime/calibration/llama31_8b_knowledge_filler_screen,generated_data/llama31_8b_knowledge_filler
transfer_output_files = generated_data/llama31_8b_knowledge_filler_responses/$(task)

output = /home/momo00016/logs/chain_of_lies/llama31_knowledge_filler_$(task).out
error  = /home/momo00016/logs/chain_of_lies/llama31_knowledge_filler_$(task).err
log    = /home/momo00016/logs/chain_of_lies/llama31_knowledge_filler_$(task).log

request_CPUs = 4
request_memory = 32G
request_GPUs = 1
requirements = (GPUs_GlobalMemoryMb >= 24000)

+MaxWallTime = 172800

queue task from (
  one_fact
  two_fact
  letter_position
)
