universe = vanilla
initialdir = /nethome/mmohammadkhani/Faithfulness-Safety
executable = /bin/bash
arguments = /nethome/mmohammadkhani/Faithfulness-Safety/experiments/scaling_regime/protocols/full_cot/run_nethome.sh $(task) $(model) $(seed) cell
environment = "HF_TOKEN=$ENV(HF_TOKEN)"
output = /scratch/mmohammadkhani/logs/chain_of_lies/full_cot_$(task)_$(model)_seed_$(seed).out
error = /scratch/mmohammadkhani/logs/chain_of_lies/full_cot_$(task)_$(model)_seed_$(seed).err
log = /scratch/mmohammadkhani/logs/chain_of_lies/full_cot_$(task)_$(model)_seed_$(seed).log
request_CPUs = 4
request_memory = $(memory_gb)G
request_GPUs = 1
request_disk = 5G
requirements = (GPUs_GlobalMemoryMb >= $(gpu_memory_mb))
