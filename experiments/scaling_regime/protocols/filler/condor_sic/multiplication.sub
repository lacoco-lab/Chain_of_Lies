# CUDA 12.8 build is required for SIC's Blackwell (sm_120) workers and also
# remains compatible with the Ampere/Hopper workers used by this queue.
universe = docker
docker_image = pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/scaling_regime/protocols/filler/run_sic.sh multiplication $(model) $(seed)

should_transfer_files = YES
when_to_transfer_output = ON_SUCCESS
success_exit_code = 0
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
preserve_relative_paths = True
environment = "HF_TOKEN=$ENV(HF_TOKEN)"
transfer_input_files = chain_of_lies,scripts,requirements.txt,pyproject.toml,experiments/scaling_regime/protocols/filler,experiments/scaling_regime/tasks/multiplication/config.json,experiments/scaling_regime/tasks/multiplication/evaluate_checkpoint.py,generated_data/multiplication_length_retraining_v1/split_manifest.json,generated_data/multiplication_length_retraining_v1/shared_eval,generated_data/multiplication_length_retraining_v1/seed_$(seed)
transfer_output_files = artifacts/filler_only_scaling_v1/multiplication/$(model)/seed_$(seed)/filler_only,generated_data/filler_only_scaling_v1_eval_responses/multiplication/$(model)/seed_$(seed)/filler_only

output = /home/momo00016/logs/chain_of_lies/filler_only_multiplication_$(model)_seed_$(seed).out
error  = /home/momo00016/logs/chain_of_lies/filler_only_multiplication_$(model)_seed_$(seed).err
log    = /home/momo00016/logs/chain_of_lies/filler_only_multiplication_$(model)_seed_$(seed).log

request_CPUs = 4
request_memory = 48G
request_GPUs = 1
request_disk = 40G
requirements = (GPUs_GlobalMemoryMb >= 40000)
+MaxWallTime = 604800
max_job_retirement_time = 28800

queue model,seed from (
  qwen 0
  qwen 1
  qwen 2
  llama 0
  llama 1
  llama 2
)
