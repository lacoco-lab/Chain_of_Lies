# Ten one-seed cells: two models by five matched mechanisms.
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/scaling_regime/tasks/plain_parity/run.sh cell $(model) $(condition)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
on_exit_hold = (ExitBySignal == True) || (ExitCode != 0)
preserve_relative_paths = True
getenv = HF_TOKEN
environment = "HF_HUB_DISABLE_XET=1"
transfer_input_files = chain_of_lies,scripts,requirements.txt,pyproject.toml,experiments/shared/check_tokenizer.py,experiments/scaling_regime/tasks/plain_parity,generated_data/parity_regime_calibration
transfer_output_files = generated_data/parity_regime_calibration_eval_responses/$(model)/seed_0/$(condition),artifacts/parity_regime_calibration/$(model)/seed_0/$(condition)

output = /home/momo00016/logs/chain_of_lies/parity_regime_$(model)_$(condition).out
error  = /home/momo00016/logs/chain_of_lies/parity_regime_$(model)_$(condition).err
log    = /home/momo00016/logs/chain_of_lies/parity_regime_$(model)_$(condition).log

request_CPUs = 4
# Activation CPU offload keeps the exact objective within 40 GB of VRAM,
# but needs ample host RAM for tensors saved for backward.
request_memory = 128G
request_GPUs = 1
requirements = (GPUs_GlobalMemoryMb >= $(gpu_memory_mb))
+MaxWallTime = 604800

queue model,condition,gpu_memory_mb from (
  qwen  vanilla          40000
  qwen  public_only_cot  40000
  qwen  filler           40000
  qwen  piggyback        40000
  qwen  steganography    40000
  llama vanilla          40000
  llama public_only_cot  40000
  llama filler           40000
  llama piggyback        40000
  llama steganography    40000
)
