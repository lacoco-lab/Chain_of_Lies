universe = vanilla

initialdir = /nethome/mmohammadkhani/Faithfulness-Safety
executable = /bin/bash
arguments = /nethome/mmohammadkhani/Faithfulness-Safety/experiments/scaling_regime/tasks/iterated_addition/condor_nethome/run.sh mmohammadkhani llama $(seed) $(condition)

# Expand only the exported token explicitly. The previous name-only getenv
# declaration was not honored by this schedd.
environment = "HF_TOKEN=$ENV(HF_TOKEN)"
output = /scratch/mmohammadkhani/logs/chain_of_lies/knowledge_all_but_one_v2_llama_seed_$(seed)_$(condition).out
error  = /scratch/mmohammadkhani/logs/chain_of_lies/knowledge_all_but_one_v2_llama_seed_$(seed)_$(condition).err
log    = /scratch/mmohammadkhani/logs/chain_of_lies/knowledge_all_but_one_v2_llama_seed_$(seed)_$(condition).log

request_CPUs = 4
request_memory = 64G
request_GPUs = 1
request_disk = 80G
requirements = (GPUs_GlobalMemoryMb >= 40000)
+MaxWallTime = 604800

queue seed,condition from (
  0 vanilla
  0 filler
  0 public_only_cot
  0 piggyback
  0 steganography
  1 vanilla
  1 filler
  1 public_only_cot
  1 piggyback
  1 steganography
  2 vanilla
  2 filler
  2 public_only_cot
  2 piggyback
  2 steganography
)
