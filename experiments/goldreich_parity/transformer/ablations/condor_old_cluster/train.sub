universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda11.8-cudnn8-runtime
batch_name = parity_goldreich_standard_ablations

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/goldreich_parity/transformer/ablations/condor_old_cluster/run.sh $(mode) $(length) generated_data/parity_goldreich_toy_transformer/seed_0 artifacts/parity_goldreich_standard_ablations/$(mode)/n$(length)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
transfer_input_files = experiments/goldreich_parity/transformer/ablations,experiments/goldreich_parity/transformer/main_experiment,generated_data/parity_goldreich_toy_transformer/seed_0/n$(length)
transfer_output_files = artifacts/parity_goldreich_standard_ablations/$(mode)/n$(length)

output = /home/momo00016/logs/chain_of_lies/parity_goldreich_standard_ablation_$(mode)_n$(length)_$(Cluster).out
error  = /home/momo00016/logs/chain_of_lies/parity_goldreich_standard_ablation_$(mode)_n$(length)_$(Cluster).err
log    = /home/momo00016/logs/chain_of_lies/parity_goldreich_standard_ablation_$(mode)_n$(length)_$(Cluster).log

request_GPUs = 1
request_CPUs = 4
request_memory = 12G
request_disk = 8G
+MaxWallTime = 604800

queue mode, length from (
no_route 32
no_route 64
end_to_end 32
end_to_end 64
)
