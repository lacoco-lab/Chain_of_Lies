universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda11.8-cudnn8-runtime
batch_name = parity_goldreich_standard_v2_targeted_retry

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/goldreich_parity/transformer/main_experiment/condor_old_cluster/run_standard_v2.sh $(length) $(model_dim) $(data_root) artifacts/parity_goldreich_standard_transformer_v2/d$(model_dim)/n$(length)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
transfer_input_files = experiments/goldreich_parity/transformer/main_experiment,$(data_root)/n$(length)
transfer_output_files = artifacts/parity_goldreich_standard_transformer_v2/d$(model_dim)/n$(length)

output = /home/momo00016/logs/chain_of_lies/parity_goldreich_standard_v2_retry_d$(model_dim)_n$(length)_$(Cluster).out
error  = /home/momo00016/logs/chain_of_lies/parity_goldreich_standard_v2_retry_d$(model_dim)_n$(length)_$(Cluster).err
log    = /home/momo00016/logs/chain_of_lies/parity_goldreich_standard_v2_retry_d$(model_dim)_n$(length)_$(Cluster).log

request_GPUs = 1
request_CPUs = 4
request_memory = $(memory)
request_disk = $(disk)
+MaxWallTime = 604800

queue model_dim, length, data_root, memory, disk from (
256 512  generated_data/parity_goldreich_toy_transformer/seed_0       12G 8G
128 2048 generated_data/parity_goldreich_toy_transformer_scale/seed_0 16G 12G
256 2048 generated_data/parity_goldreich_toy_transformer_scale/seed_0 16G 12G
)
