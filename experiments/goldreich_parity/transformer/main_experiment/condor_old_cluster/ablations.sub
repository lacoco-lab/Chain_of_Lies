universe = docker
docker_image = pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/goldreich_parity/transformer/main_experiment/condor_old_cluster/run_ablation.sh $(supervision) $(length)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
