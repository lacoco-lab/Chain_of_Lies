universe = docker
docker_image = pytorch/pytorch:2.8.0-cuda12.8-cudnn9-runtime
batch_name = parity_goldreich_softmax_base

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/goldreich_parity/transformer/main_experiment/condor_old_cluster/run_softmax_eval.sh $(length) experiments/goldreich_parity/transformer/main_experiment/config.json generated_data/parity_goldreich_toy_transformer/seed_0 artifacts/parity_goldreich_toy_transformer

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
transfer_input_files = experiments/goldreich_parity/transformer/main_experiment,generated_data/parity_goldreich_toy_transformer/seed_0/n$(length)/test.jsonl.gz,artifacts/parity_goldreich_toy_transformer/n$(length)/model.pt,artifacts/parity_goldreich_toy_transformer/n$(length)/metrics.json
transfer_output_files = artifacts/parity_goldreich_toy_transformer_softmax/n$(length)

output = /home/momo00016/logs/chain_of_lies/parity_goldreich_softmax_n$(length)_$(Cluster).out
error  = /home/momo00016/logs/chain_of_lies/parity_goldreich_softmax_n$(length)_$(Cluster).err
log    = /home/momo00016/logs/chain_of_lies/parity_goldreich_softmax_n$(length)_$(Cluster).log

request_GPUs = $(gpus)
request_CPUs = $(cpus)
request_memory = $(memory)
request_disk = 4G

+MaxWallTime = 86400

queue length, gpus, cpus, memory from (
32  0 4 8G
64  0 4 8G
256 0 8 12G
512 1 4 12G
)
