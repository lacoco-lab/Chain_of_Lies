universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda11.8-cudnn8-runtime
batch_name = parity_standard_cot_controls_easy

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/goldreich_parity/transformer/controls/condor_old_cluster/run.sh $(condition) $(length) generated_data/parity_standard_cot_controls_easy/seed_0 artifacts/parity_standard_cot_controls/$(condition)/n$(length)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
transfer_input_files = experiments/goldreich_parity/transformer/controls,experiments/goldreich_parity/transformer/main_experiment,generated_data/parity_standard_cot_controls_easy/seed_0/n$(length)
transfer_output_files = artifacts/parity_standard_cot_controls/$(condition)/n$(length)

output = /home/momo00016/logs/chain_of_lies/parity_standard_control_$(condition)_n$(length)_$(Cluster).out
error  = /home/momo00016/logs/chain_of_lies/parity_standard_control_$(condition)_n$(length)_$(Cluster).err
log    = /home/momo00016/logs/chain_of_lies/parity_standard_control_$(condition)_n$(length)_$(Cluster).log

request_GPUs = 1
request_CPUs = 4
request_memory = 10G
request_disk = 6G
+MaxWallTime = 259200

queue condition, length from (
no_cot 4
no_cot 8
no_cot 16
filler_cot 4
filler_cot 8
filler_cot 16
normal_cot 4
normal_cot 8
normal_cot 16
)
