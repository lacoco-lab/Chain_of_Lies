universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda11.8-cudnn8-runtime
batch_name = parity_standard_cot_controls_staged_large

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/goldreich_parity/transformer/controls/condor_old_cluster/run.sh $(condition) $(length) generated_data/parity_goldreich_toy_transformer/seed_0 artifacts/parity_standard_cot_controls_staged/$(condition)/n$(length) experiments/goldreich_parity/transformer/controls/staged_large_config.json

should_transfer_files = YES
