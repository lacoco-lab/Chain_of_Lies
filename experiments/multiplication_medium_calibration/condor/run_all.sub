# Three independent seed-0 conditions use identical data and three fixed CE epochs.
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/multiplication_medium_calibration/run.sh train_eval $(condition) $(supervision_mode) $(train_tokens) $(eval_tokens)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
getenv = HF_TOKEN
environment = "HF_HUB_DISABLE_XET=1"
transfer_input_files = chain_of_lies,scripts,requirements.txt,pyproject.toml,experiments/multiplication_medium_calibration,generated_data/multiplication_medium_calibration/seed_0/mul_medium
transfer_output_files = generated_data/multiplication_medium_calibration_eval_responses/seed_0/$(condition)/mul_medium,artifacts/ce_multiplication_medium_calibration/seed_0/$(condition)/mul_medium

output = /home/momo00016/logs/chain_of_lies/multiplication_medium_run_$(condition).out
error  = /home/momo00016/logs/chain_of_lies/multiplication_medium_run_$(condition).err
log    = /home/momo00016/logs/chain_of_lies/multiplication_medium_run_$(condition).log

request_CPUs = 4
request_memory = $(memory)
request_GPUs = 1
requirements = (GPUs_GlobalMemoryMb >= $(gpu_memory_mb))

+MaxWallTime = 259200

queue condition,supervision_mode,train_tokens,eval_tokens,memory,gpu_memory_mb from (
  answer_only        answer_only         256 1536 32G 24000
  public_cot         public_cot          768 1536 48G 40000
  verbose_public_cot verbose_public_cot 1536 1536 64G 80000
)
