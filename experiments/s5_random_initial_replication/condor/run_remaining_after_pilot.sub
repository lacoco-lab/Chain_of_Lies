# Complete all conditions except the already-finished seed-0 public-CoT pilot.
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/s5_random_initial_replication/run.sh train_eval $(variant) $(mode) $(seed) $(epochs) $(train_tokens) $(save_every) $(eval_every) $(eval_tokens)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
transfer_input_files = chain_of_lies,scripts,requirements.txt,pyproject.toml,experiments/s5_random_initial_replication/run.sh,generated_data/s5_random_initial_replication/seed_$(seed)/$(variant)
transfer_output_files = generated_data/s5_random_initial_replication_eval_responses/seed_$(seed)/$(mode)/$(variant),artifacts/ce_s5_random_initial_replication/seed_$(seed)/$(mode)/$(variant)

output = /home/momo00016/logs/chain_of_lies/s5_random_init_run_$(mode)_$(variant)_seed_$(seed).out
error  = /home/momo00016/logs/chain_of_lies/s5_random_init_run_$(mode)_$(variant)_seed_$(seed).err
log    = /home/momo00016/logs/chain_of_lies/s5_random_init_run_$(mode)_$(variant)_seed_$(seed).log

request_CPUs = 4
request_memory = $(memory)
request_GPUs = 1
requirements = (GPUs_GlobalMemoryMb >= $(gpu_memory_mb))

+MaxWallTime = 259200

queue seed,mode,variant,epochs,train_tokens,save_every,eval_every,eval_tokens,memory,gpu_memory_mb from (
  0 answer_only        s5_piggyback 1  512  5000  5000  512 48G 40000
  0 answer_only        s5_control   1  512  5000  5000  512 48G 40000
  0 verbose_public_cot s5_piggyback 3 1024 10000 10000 2048 64G 80000
  0 verbose_public_cot s5_control   3 1024 10000 10000 2048 64G 80000
  1 answer_only        s5_piggyback 1  512  5000  5000  512 48G 40000
  1 answer_only        s5_control   1  512  5000  5000  512 48G 40000
  1 public_cot         s5_piggyback 1  512  5000  5000  512 64G 80000
  1 public_cot         s5_control   1  512  5000  5000  512 64G 80000
  1 verbose_public_cot s5_piggyback 3 1024 10000 10000 2048 64G 80000
  1 verbose_public_cot s5_control   3 1024 10000 10000 2048 64G 80000
  2 answer_only        s5_piggyback 1  512  5000  5000  512 48G 40000
  2 answer_only        s5_control   1  512  5000  5000  512 48G 40000
  2 public_cot         s5_piggyback 1  512  5000  5000  512 64G 80000
  2 public_cot         s5_control   1  512  5000  5000  512 64G 80000
  2 verbose_public_cot s5_piggyback 3 1024 10000 10000 2048 64G 80000
  2 verbose_public_cot s5_control   3 1024 10000 10000 2048 64G 80000
)
