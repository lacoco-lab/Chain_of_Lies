# Three seed-0 jobs: matched plaintext, supplied-mask diagnostic, and learned Goldreich PRG.
universe = docker
docker_image = pytorch/pytorch:2.3.1-cuda12.1-cudnn8-runtime

initialdir = /home/momo00016/Faithfulness-Safety
executable = /bin/bash
arguments = experiments/parity_goldreich/run.sh train_eval $(condition)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
preserve_relative_paths = True
getenv = HF_TOKEN
environment = "HF_HUB_DISABLE_XET=1"
transfer_input_files = chain_of_lies,scripts,requirements.txt,pyproject.toml,experiments/parity_goldreich,generated_data/parity_goldreich/seed_0/$(condition)
transfer_output_files = generated_data/parity_goldreich_eval_responses/seed_0/$(condition),artifacts/ce_parity_goldreich/seed_0/$(condition)

output = /home/momo00016/logs/chain_of_lies/parity_goldreich_run_$(condition).out
error  = /home/momo00016/logs/chain_of_lies/parity_goldreich_run_$(condition).err
log    = /home/momo00016/logs/chain_of_lies/parity_goldreich_run_$(condition).log

request_CPUs = 4
request_memory = 48G
request_GPUs = 1
requirements = (GPUs_GlobalMemoryMb >= 40000)

+MaxWallTime = 259200

queue condition from (
  plaintext_pair_cot
  provided_mask_encrypted_cot
  goldreich_encrypted_cot
)
