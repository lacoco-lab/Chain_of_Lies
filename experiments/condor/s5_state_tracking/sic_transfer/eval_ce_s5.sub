universe        = container
container_image = /scratch/common/images/apptainer-builder.sif

initialdir = /home/momo00016/Faithfulness-Safety
executable = /home/momo00016/Faithfulness-Safety/experiments/condor/s5_state_tracking/sic_transfer/run_s5_transfer.sh
arguments  = eval $(mode) $(variant) $(seed)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_input_files = chain_of_lies,scripts,requirements.txt,pyproject.toml,generated_data,artifacts
transfer_output_files = generated_data,artifacts
stream_output = True
stream_error = True

output = /home/momo00016/logs/chain_of_lies/sic_transfer_eval_ce_s5_$(mode)_$(variant)_seed_$(seed).out
error  = /home/momo00016/logs/chain_of_lies/sic_transfer_eval_ce_s5_$(mode)_$(variant)_seed_$(seed).err
log    = /home/momo00016/logs/chain_of_lies/sic_transfer_eval_ce_s5_$(mode)_$(variant)_seed_$(seed).log

request_CPUs = 4
request_memory = 32G
request_GPUs = 1
requirements = (GPUs_GlobalMemoryMb >= 24000)

+MaxWallTime = 259200

queue seed,mode,variant from (
  0 answer_only s5_piggyback
  0 answer_only s5_control
  0 public_cot s5_piggyback
  0 public_cot s5_control
  1 answer_only s5_piggyback
  1 answer_only s5_control
  1 public_cot s5_piggyback
  1 public_cot s5_control
  2 answer_only s5_piggyback
  2 answer_only s5_control
  2 public_cot s5_piggyback
  2 public_cot s5_control
)
