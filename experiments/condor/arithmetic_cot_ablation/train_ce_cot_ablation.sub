universe = vanilla

initialdir = /nethome/mmohammadkhani/Faithfulness-Safety
executable = /bin/bash
arguments = /nethome/mmohammadkhani/Faithfulness-Safety/experiments/condor/arithmetic_cot_ablation/train_ce_cot_ablation.sh mmohammadkhani $(variant) $(mode) $(seed) 1 5000 5000

output = /scratch/mmohammadkhani/logs/chain_of_lies/train_ce_cot_ablation_$(mode)_$(variant)_seed_$(seed).out
error  = /scratch/mmohammadkhani/logs/chain_of_lies/train_ce_cot_ablation_$(mode)_$(variant)_seed_$(seed).err
log    = /scratch/mmohammadkhani/logs/chain_of_lies/train_ce_cot_ablation_$(mode)_$(variant)_seed_$(seed).log

request_CPUs = 4
request_memory = 32G
request_GPUs = 1
requirements = (GPUs_GlobalMemoryMb >= 20000)

+MaxWallTime = 259200

queue seed,mode,variant from (
  0 answer_only arith_piggyback
  0 answer_only arith_piggyback_control
  0 public_cot arith_piggyback
  0 public_cot arith_piggyback_control
  1 answer_only arith_piggyback
  1 answer_only arith_piggyback_control
  1 public_cot arith_piggyback
  1 public_cot arith_piggyback_control
  2 answer_only arith_piggyback
  2 answer_only arith_piggyback_control
  2 public_cot arith_piggyback
  2 public_cot arith_piggyback_control
)
